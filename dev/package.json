{
  "name": "longshot-dev",
  "private": true,
  "type": "module",
  "description": "Development tooling for the LongShot Chrome extension (icons, tests). Not part of the extension package.",
  "scripts": {
    "icons": "node generate-icons.mjs",
    "test:unit": "node test/unit.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:popup": "node test/popup-height.mjs",
    "test": "node test/unit.mjs && node test/e2e.mjs",
    "package": "node package-extension.mjs"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "puppeteer": "^25.10.0"
  }
}
